{
  "name": "RLI Consulting",
  "dataColors": ["#1F3A5F", "#5B7DA8", "#9AA5B1", "#C8553D", "#2E7D6B", "#B08D57", "#7A6C9D", "#3E8FB0"],
  "background": "#FFFFFF",
  "foreground": "#1F2A37",
  "tableAccent": "#1F3A5F",
  "good": "#2E7D6B",
  "neutral": "#B08D57",
  "bad": "#C8553D",
  "maximum": "#1F3A5F",
  "center": "#9AA5B1",
  "minimum": "#EEF1F5",
  "textClasses": {
    "callout": { "fontSize": 26, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "title":   { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "header":  { "fontSize": 12, "fontFace": "Segoe UI Semibold", "color": "#1F2A37" },
    "label":   { "fontSize": 10, "fontFace": "Segoe UI", "color": "#5B6675" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E3E7ED" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#F4F6F9" } }, "transparency": 0 }]
      }
    }
  }
}
